{
    "port": 5467,
    "use_cloudflare": false,
    "allow_remote_host_admin": false,
    "playback": {
        "buffer_ahead_seconds": 30,
        "buffer_behind_seconds": 30,
        "segment_wait_timeout_seconds": 30,
        "soft_sync_drift_seconds": 0.25,
        "hard_sync_drift_seconds": 2.0,
        "inactive_playback_grace_seconds": 0
    },
    "sources": [
        {
            "id": "local",
            "type": "directory",
            "label": "Midia local",
            "enabled": true,
            "options": {
                "path": "C:\\caminho\\para\\seus\\videos",
                "ffmpeg_path": "ffmpeg.exe",
                "transcode_profile": "chrome-h264-aac",
                "hardware_acceleration": "auto"
            }
        },
        {
            "id": "crunchyroll",
            "type": "crunchyroll",
            "label": "Crunchyroll",
            "enabled": false,
            "options": {
                "cache_path": "D:\\Series e Filmes\\CrunchyrollCache",
                "etp_rt": "COLE_O_COOKIE_ETP_RT_AQUI",
                "locale": "pt-BR",
                "audio_languages": ["pt-BR", "ja-JP"],
                "subtitle_languages": ["pt-BR"],
                "video_quality": "1080p",
                "audio_quality": "192k",
                "metadata_ttl_hours": 24,
                "worker_idle_seconds": 120,
                "max_segment_downloads": 4,
                "max_playback_sessions": 2,
                "worker_path": "bin\\crunchyroll-worker.exe",
                "ffmpeg_path": "ffmpeg.exe",
                "export_path": "D:\\Series e Filmes\\CrunchyrollExports",
                "client_id_path": "secrets\\client_id.bin",
                "private_key_path": "secrets\\private_key.pem"
            }
        }
    ]
}
